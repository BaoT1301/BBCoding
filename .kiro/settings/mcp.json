{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "disabled": true,
      "autoApprove": ["*"]
    },
    
    "mcp-context-manager": {
      "command": "docker",
      "args": ["exec", "-i", "mcp-context-manager", "node", "dist/server.js", "--stdio-only"],
      "disabled": false,
      "autoApprove": ["*"]
    }
  }
}