# MCP Services — Environment Variables
# Copy this file to .env and adjust values for your project.
# All variables are optional; defaults are shown.

# ── Workspace ────────────────────────────────────────────────────────────────
# Path to the workspace root that MCP should scan.
# Can be relative (to the project root) or absolute.
# Default: current directory (.)
WORKSPACE_PATH=.

# ── HTTP Port ────────────────────────────────────────────────────────────────
# Port the MCP Context Manager HTTP API listens on inside the container.
# Override if 3001 conflicts with another service on your host.
# Default: 3001
HTTP_PORT=3001

# ── Graph Snapshot Directory ─────────────────────────────────────────────────
# Optional: override the directory where the indexer persists its graph
# snapshot between restarts. Useful when you want snapshots stored outside
# the container (e.g. on a named volume for faster cold-start).
# Default: internal container path managed by the service
# GRAPH_SNAPSHOT_DIR=/data/snapshots

# ── Indexer Glob Patterns ─────────────────────────────────────────────────────
# Comma-separated glob patterns for Python files (brace-expansion safe).
# Default: **/*.py  (workspace-wide)
# PYTHON_WATCH_GLOBS=myapp/**/*.py,tests/**/*.py

# Comma-separated glob patterns for TypeScript/JavaScript files (brace-expansion safe).
# Default: **/*.{ts,tsx,js,jsx}  (workspace-wide)
# TS_WATCH_GLOBS=src/**/*.{ts,tsx},packages/**/*.{ts,tsx}

# Comma-separated glob patterns to EXCLUDE from indexing and watching.
# Default: node_modules, dist, build, .next, .turbo, coverage, .git, .venv,
#          venv, __pycache__, .tools/mcp-context-*, services/mcp-context-*, .kiro, .claude
# WATCH_IGNORES=custom/**,other/**
