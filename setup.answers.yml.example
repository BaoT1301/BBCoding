# setup.answers.yml.example
# Copy to setup.answers.yml and fill in your values.
# Used by: ./setup.sh --non-interactive
#
# All keys are required unless marked optional.

project_name: My Project

# Number of clusters (1–8)
num_clusters: 2

# Cluster 1
cluster_1_id: backend
cluster_1_path: backend/
cluster_1_label: Backend API
cluster_1_color: "#4A90D9"

# Cluster 2
cluster_2_id: frontend
cluster_2_path: frontend/src/
cluster_2_label: Frontend
cluster_2_color: "#E28A4A"

# AI tool: kiro | cursor | claude-desktop | skip
ai_tool: skip
